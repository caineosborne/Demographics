# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Offline source data; keep only the importer code tracked.
# Local source data is ignored, while the tracked data-access package remains visible.
data/*
!data/__init__.py
!data/tools.py
!data/phase4_claims.py
!data/database_config.py
!data/database_maintenance.py
data/source_data/
Data_Files/*
!Data_Files/import_wpp_vintages.py

# Runtime database artifacts; keep only documentation and the committed
# pre-migration inventory visible to Git.
databases/*
!databases/README.md
!databases/inventory/
databases/inventory/*
!databases/inventory/2026-09-12-pre-migration.json

.env

# macOS metadata
.DS_Store
